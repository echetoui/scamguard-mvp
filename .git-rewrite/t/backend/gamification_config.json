      },
      "silver": {
        "name": "Silver",
        "xp_reward": 25,
        "icon": "🥈"
      },
      "gold": {
        "name": "Gold",
        "xp_reward": 50,
        "icon": "🥇"
      },
      "platinum": {
        "name": "Platinum",
